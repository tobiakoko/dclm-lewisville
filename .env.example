# ------------------------------------------------------------------
# Deeper Life Bible Church Lewisville - Environment Variables
# Copy to .env.local and fill in real values. Never commit .env files.
# ------------------------------------------------------------------

# --- Sanity CMS (public, safe to expose to the browser) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-10-28

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://deeperlifelewisville.org
# Google Analytics; leave empty unless the owner has supplied an ID
NEXT_PUBLIC_GA_ID=

# --- Form email via Resend (server only) ---
# Without all three, forms show an error with the church phone number.
RESEND_API_KEY=
# Where form email goes. Production only: info@deeperlifelewisville.org.
# Anywhere else (local, preview, CI) use your own test inbox; the church address is rejected.
CONTACT_INBOX=
# Sender on a domain verified in Resend, e.g. "Website <website@your-verified-domain>"
CONTACT_FROM=

# --- Sanity (server only) ---
# Read-only Sanity API token (do NOT use a write token)
SANITY_API_TOKEN=
# Secret shared with the Sanity webhook that calls /api/revalidate (min 16 chars)
SANITY_REVALIDATE_SECRET=

# --- Upstash Redis (server only, optional but recommended) ---
# Used for durable rate limiting across serverless instances.
# If unset, the app falls back to per-instance in-memory rate limiting.
UPSTASH_REDIS_REST_URL=https://your-account.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- Build ---
# Set to "true" to skip env validation during builds (CI/Docker)
SKIP_ENV_VALIDATION=
